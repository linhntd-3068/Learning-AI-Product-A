# Copy to .env.local (local) and add the same names in Vercel → Project → Settings → Environment Variables.
# Values: Supabase dashboard → Project Settings → API Keys. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" key under NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — or the legacy "service_role" key under SUPABASE_SERVICE_ROLE_KEY. Server only.
SUPABASE_SECRET_KEY=

# Optional: password for the demo accounts created by scripts/create-demo-users.mjs
# DEMO_PASSWORD=
